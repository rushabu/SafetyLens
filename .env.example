# SafetyLens configuration. Copy to .env and edit. Never commit .env.
# With no changes at all, SafetyLens runs in the labelled rule-based BASELINE mode (no credentials needed).

# ---- Storage -------------------------------------------------------------
# Local default: <repo>/data/db/safetylens.db   (Docker Compose overrides this to a named volume)
# DATABASE_URL=sqlite:///C:/path/to/safetylens.db

# ---- Default engine offered in the UI --------------------------------------
# baseline | llm   (llm is only used when the LLM settings below are complete)
ANALYSIS_ENGINE=baseline

# ---- Optional LLM adapter -------------------------------------------------
# LLM_PROVIDER: none | anthropic | openai_compatible
LLM_PROVIDER=none
LLM_MODEL=

# Option A - hosted Claude via the Anthropic API:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-opus-5-5
#   LLM_API_KEY=<your Anthropic API key>
#   LLM_EFFORT=medium                 # low | medium | high | xhigh | max
#   LLM_ANTHROPIC_FALLBACKS=true      # server-side refusal fallback; the serving model is recorded per analysis
#
# Option B - local model server with an OpenAI-compatible API (Ollama, vLLM, LM Studio, llama.cpp):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=http://localhost:11434/v1     # from Docker use http://host.docker.internal:11434/v1
#   LLM_MODEL=qwen2.5:14b-instruct
#   LLM_API_KEY=                                # usually empty for local servers
#
# Option C - Groq (hosted, OpenAI-compatible; used during development of this prototype):
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_API_KEY_FILE=key.txt                    # file containing only the key (gitignored)
#   LLM_EXTRA_BODY={"reasoning_effort": "medium"}
LLM_BASE_URL=
LLM_API_KEY=
# Either put the key in LLM_API_KEY, or keep it in a separate file and point to it here
# (relative paths are resolved from the repository root). With Docker, use docker-compose.llm.yml.
LLM_API_KEY_FILE=
# Optional provider-specific JSON merged into OpenAI-compatible requests.
LLM_EXTRA_BODY=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8000

# ---- External-processing guard ---------------------------------------------
# synthetic_only: a NON-LOCAL LLM endpoint may only receive reports labelled synthetic.
# all:            any report may be sent to the configured provider. Set this only after
#                 confirming that real report data may be processed by that provider.
# Local endpoints (localhost / 127.0.0.1 / host.docker.internal) are always allowed.
LLM_DATA_POLICY=synthetic_only

# ---- Misc -----------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_REPORT_CHARS=10000
NEAR_DUPLICATE_THRESHOLD=92
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
